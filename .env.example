# App identity — set these in Vercel environment variables or your local .env.local
# NEXT_PUBLIC_ prefix makes them available in both server and client code at build time.

# The display name of the application (used in logo, page titles, footer, etc.)
NEXT_PUBLIC_APP_NAME=Prodvo

# The primary domain used for contact/support email addresses (e.g. support@yourdomain.com)
NEXT_PUBLIC_APP_DOMAIN=prodvo.studio

# Team members on the About page are configured in src/data/team.json
# Place team member images in public/images/team/
